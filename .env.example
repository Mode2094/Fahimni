# Server only. Never prefix these values with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=marin
# Frontend design work without spending OpenAI credits: replays a local lesson fixture.
NEXT_PUBLIC_VISUAL_DEV_MODE=false
TUTOR_DIAGNOSTICS=false

# PostgreSQL connection string used by Drizzle (server only).
DATABASE_URL=postgresql://user:password@localhost:5432/fahimni
# Google OAuth credentials from Google Cloud Console (server only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production. Signs OAuth state and hashes session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
# Comma-separated list of Google account emails that receive the ADMIN role on login.
ADMIN_EMAILS=
# Optional: used only by the Postgres integration test (tests/auth-db.test.ts).
TEST_DATABASE_URL=

# Persistent storage outside the public web root for uploaded books and page images.
# The worker (pnpm worker:index) and the app must share this directory.
DATA_DIR=/data/fahimni
# Optional: Python interpreter that has PyMuPDF installed (default: python3).
# INDEX_PYTHON_BIN=/opt/fahimni/venv/bin/python3
# Optional: indexing timeout in milliseconds (default: 600000).
# INDEX_TIMEOUT_MS=600000

# Freemius SaaS billing (server only — NEVER expose API/secret keys to the browser).
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=

# Redis is REQUIRED in production for AI rate limiting (per user + operation).
# In development/test the in-memory limiter is used when this is empty.
REDIS_URL=

# Public contact: the business WhatsApp number in international format.
# Digits with optional "+" or spaces (e.g. +9627XXXXXXXX). The homepage renders
# the WhatsApp contact section only when this is set and valid.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Free trial (one-time, 15 credits, 48h from the first accepted AI request).
# Turnstile protects trial activation only. Production trial activation FAILS
# CLOSED when the secret is missing; paid subscriptions are unaffected.
# Site key is public (also readable as NEXT_PUBLIC_TURNSTILE_SITE_KEY).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: expected Turnstile hostname/action assertions.
# TURNSTILE_EXPECTED_HOSTNAME=app.fahimni.com
# Dedicated HMAC secret for the trial browser identity cookie (falls back to AUTH_SECRET).
TRIAL_IDENTITY_SECRET=
[REDACTED:API key param] Global daily AI spending budget for ALL trial-backed requests (USD).
TRIAL_DAILY_AI_BUDGET_USD=5

# Encryption root key for admin-managed secrets stored in the database
# (OpenAI key, Freemius credentials) using AES-256-GCM. Generate with:
#   openssl rand -base64 32
# Requirements: never store this key in the database, never commit it, and keep
# it OUT of database backups — restoring a database without this key makes all
# encrypted settings unreadable (the app then treats them as unconfigured and
# falls back to environment variables where available).
SETTINGS_ENCRYPTION_KEY=

# Fahimni production environment — copy to deploy/env.production and fill in.
# NEVER commit real secrets. This file is only an example.

# --- Database / cache (internal to the compose network) ---
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://fahimni:change-me-strong-password@fahimni-postgres:5432/fahimni
REDIS_URL=redis://fahimni-redis:6379

# --- Persistent book storage (shared by web + worker, host bind mount) ---
DATA_DIR=/data/fahimni

# --- Auth (server only) ---
AUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# --- Admin-managed secret encryption (server only) ---
# 32-byte root key (base64 or 64-char hex): openssl rand -base64 32
# Encrypts the OpenAI key and Freemius credentials stored from the admin UI.
# Keep it OUT of database backups and store it in a secret manager: without it
# the encrypted settings are unreadable (the app treats them as unconfigured
# and falls back to the environment variables below).
SETTINGS_ENCRYPTION_KEY=

# --- OpenAI (server only) ---
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=marin

# --- Freemius billing (server only) ---
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=

# --- Free trial (server only) ---
# Production trial activation fails closed without TURNSTILE_SECRET_KEY.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: TURNSTILE_EXPECTED_HOSTNAME=app.fahimni.com
# Optional dedicated HMAC secret for the trial browser identity (falls back to AUTH_SECRET).
TRIAL_IDENTITY_SECRET=
# Global daily AI spending budget for all trial-backed requests (USD).
TRIAL_DAILY_AI_BUDGET_USD=5

# --- Public contact (browser-visible, not a secret) ---
# Business WhatsApp number, international format (e.g. +9627XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Public site URL (browser-visible, not a secret) ---
# Used for metadataBase / canonical URLs / Open Graph in production.
NEXT_PUBLIC_SITE_URL=https://fahimni.me

# --- Optional ---
# INDEX_PYTHON_BIN=/usr/bin/python3
# INDEX_TIMEOUT_MS=600000
# WORKER_POLL_MS=5000
# TUTOR_DIAGNOSTICS=false

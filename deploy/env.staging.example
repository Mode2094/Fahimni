# Fahimni STAGING environment — copy to deploy/env.staging and fill in.
# NEVER commit real secrets. This file is only an example.
#
# Staging is fully isolated from production on the same VPS: every compose
# name, port, database and data path below is different. Run the stack with:
#   docker compose --env-file deploy/env.staging -f deploy/docker-compose.production.yml up -d
#
# Use a DIFFERENT SETTINGS_ENCRYPTION_KEY than production so the two
# environments can never decrypt each other's admin-managed secrets.

# --- Compose stack isolation (read by docker compose, not the app) ---
STACK_PREFIX=fahimni-staging
WEB_PORT=3101
POSTGRES_DB=fahimni_staging
DATA_HOST_DIR=/data/fahimni-staging
DATA_CONTAINER_DIR=/data/fahimni-staging
ENV_FILE=./env.staging

# --- Database / cache (internal to the staging compose network) ---
POSTGRES_PASSWORD=change-me-staging-password
DATABASE_URL=postgresql://fahimni:change-me-staging-password@fahimni-postgres:5432/fahimni_staging
REDIS_URL=redis://fahimni-redis:6379

# --- Persistent storage (shared by staging web + worker, host bind mount) ---
DATA_DIR=/data/fahimni-staging

# --- Auth (server only) ---
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# --- Admin-managed secret encryption (server only) ---
# 32-byte root key (base64 or 64-char hex): openssl rand -base64 32
# Keep it OUT of database backups; without it encrypted admin settings cannot
# be restored. Staging should use its own key, separate from production.
SETTINGS_ENCRYPTION_KEY=

# --- OpenAI (server only) ---
# Leave OPENAI_API_KEY empty to force admin-managed keys, or set it as the
# bootstrap fallback. The admin dashboard can add/rotate the key at runtime.
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=marin

# --- Freemius billing (server only) ---
# For staging, prefer TEST/sandbox product credentials. Never use the live
# product on a staging domain you would not want customers to reach.
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=

# --- Free trial (server only) ---
# Staging trial activation FAILS CLOSED without TURNSTILE_SECRET_KEY.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TRIAL_IDENTITY_SECRET=
TRIAL_DAILY_AI_BUDGET_USD=2

# --- Public contact (browser-visible, not a secret) ---
# Optional bootstrap value; the admin dashboard (Settings → WhatsApp) is the
# runtime source of truth and does not require redeploying to change.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Public site URL (browser-visible, not a secret) ---
# Staging URL (noindex + basic auth at the proxy); used for canonical/OG tags.
NEXT_PUBLIC_SITE_URL=https://staging.fahimni.me

# --- Optional ---
# INDEX_PYTHON_BIN=/usr/bin/python3
# INDEX_TIMEOUT_MS=600000
# WORKER_POLL_MS=5000
# TUTOR_DIAGNOSTICS=false
# DATABASE_POOL_MAX=5
# STAGING_DATA_HOST_DIR=/data/fahimni-staging
# Never set NEXT_PUBLIC_VISUAL_DEV_MODE in staging/production.
